# ==============================================================================
# AI Fire & Smoke Detection System - Environment Configuration
# Copy this file to '.env' and supply your custom credentials.
# NEVER commit real credentials or private keys to version control.
# ==============================================================================

# SMTP Email Alert Configuration (Optional - leave empty to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
ALERT_SENDER_EMAIL=your_email@gmail.com
ALERT_RECIPIENT_EMAIL=safety_officer@example.com

# Multi-Camera Channel Configuration (Optional)
DEFAULT_CAMERA_INDEX=0
DEFAULT_CAMERA_ID=cam_0
